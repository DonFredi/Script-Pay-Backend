NODE_ENV=development
PORT=4000

DATABASE_URL=
# Non-pooled connection, used only by Prisma Migrate — see prisma/schema.prisma.
DIRECT_URL=
# REQUIRED — the app refuses to boot without it. Backs PrismaPrivilegedService
# (see its own doc comment) for the queries that cannot scope to one tenant:
# login-by-email, API-key resolution, and the cross-tenant pollers.
#
# Point it at the app_privileged (BYPASSRLS) role. NEVER at app_runtime: that role
# is subject to FORCE ROW LEVEL SECURITY, so those queries would return zero rows
# instead of erroring — every login rejected, every API key rejected, every Daraja
# callback left unprocessed, with nothing in the logs to say why.
#
# If RLS has not been applied to your database at all, set this to the same value
# as DATABASE_URL. It used to default to that silently; it no longer does, because
# after the cutover the silent default is the outage described above.
PRIVILEGED_DATABASE_URL=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
 MPESA_SHORTCODE=
MPESA_PASSKEY=

MPESA_ENV=sandbox
MPESA_CALLBACK_BASE_URL=
# Shared secret embedded as ?token= in the Daraja callback URLs registered with
# Safaricom — Daraja doesn't sign webhook payloads, so this is what tells a real
# callback apart from a forged one. Generate with: openssl rand -hex 32
DARAJA_WEBHOOK_SECRET=
API_KEY_HASH_PEPPER=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=

# Transactional email (signup verification, password reset) — backend owns it directly via Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_TTL_HOURS=
PASSWORD_RESET_TTL_MINUTES=

FRONTEND_ORIGIN=http://localhost:3000,https://sript-pay.vercel.app
PUBLIC_APP_URL=http://localhost:3000

SENTRY_DSN=
SLACK_WEBHOOK_URL=
# Redundant channel for critical-severity alerts only — reuses RESEND_API_KEY/EMAIL_FROM above.
ALERTS_EMAIL_TO=
CREDENTIALS_ENCRYPTION_KEY=

# Product name used in outbound email subject lines and alert prefixes. Optional —
# unset defaults to "ScriptPay". Only matters if this codebase is deployed under a
# different brand.
PLATFORM_NAME=

# --- Background job scheduling ---
# "in-process" (default) runs the pollers from @nestjs/schedule crons and requires a
# host that keeps the process alive. "external" silences those crons and expects a
# scheduler (cron-job.org, Supabase pg_cron, UptimeRobot) to POST the /internal/jobs/*
# routes instead — required on any host that suspends an idle instance, e.g. a Render
# free instance, which sleeps after 15 minutes. Never run both at once: the pollers
# claim no rows, so two concurrent runs can credit a tenant twice for one payment.
JOB_SCHEDULER=in-process
# Sent by the scheduler as the x-internal-jobs-secret header. The guard fails closed
# when unset, so blank disables the endpoints rather than exposing them.
# Generate with: openssl rand -hex 32
INTERNAL_JOBS_SECRET=
